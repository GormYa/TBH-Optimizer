# Executáveis compilados do Go
*.exe
*.exe~
*.dll
*.so
*.dylib
OtimizadorFarm.exe

# Pastas de cache e dados baixados em runtime pelo aplicativo
gamedata/

# Históricos locais e arquivos temporários de teste
historico_farm.txt
stage_history.json
tmp_drop_extract/
scripts/__pycache__/
*.tmp

# Temporários do auto-update (*.exe já cobre o exe, mas .old/.new não casam nele)
*.exe.old
*.exe.new

# Arquivos locais de saves e dados de debug (privacidade do jogador)
data/

# Arquivos de IDEs (IntelliJ, VS Code, etc.)
.idea/
.claude/
*.iml
.vscode/
docs/

# Pasta criada para teste
scripts/

# Arquivo de automação (helper local)
*.ps1

# tools/ = scripts de extração / engenharia reversa (dev local) -> NUNCA commitar.
# O app embute os JSON já extraídos; nada em tools/ precisa ir pro git.
tools/

# binário compilado (injeta a chave ES3 via ldflags; nunca commitar)
optimizer.exe
node_modules/

.superpowers
